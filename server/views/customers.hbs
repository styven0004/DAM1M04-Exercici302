<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  {{> header}}
  <link rel="stylesheet" href="/estils.css">
  <title>Sakila - Customers</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>👥 Clients (Top 25)</h1>

    <section>
      {{#each customers}}
        <article class="card">
          <h2>{{first_name}} {{last_name}}</h2>

          {{#if rentals}}
            <p><strong>Últims lloguers:</strong></p>
            <p class="muted">{{rentals}}</p>
          {{else}}
            <p class="muted">Sense lloguers</p>
          {{/if}}

        </article>
      {{/each}}
    </section>
  </main>

  {{> footer}}
</body>
</html>
