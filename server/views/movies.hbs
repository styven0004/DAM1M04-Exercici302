<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  {{> header}}
  <link rel="stylesheet" href="/estils.css">
  <title>Sakila - Movies</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>🎬 Llistat de Pel·lícules (Top 15)</h1>

    <section>
      {{#each movies}}
        <article class="card">
          <h2>{{title}} ({{release_year}})</h2>

          <p class="muted">
            {{description}}
          </p>

          <p>
            <strong>Actors:</strong><br>
            {{actors}}
          </p>
        </article>
      {{/each}}
    </section>
  </main>

  {{> footer}}
</body>
</html>
