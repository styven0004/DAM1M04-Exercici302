<!DOCTYPE html>
<html lang="ca">
<head>
  {{> header}}
  <title>Sakila - Customers</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>👥 Clients (Top 25)</h1>

    <p>Llistat de clients i els seus primers lloguers</p>

    <table class="table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Cognom</th>
          <th>Lloguers</th>
        </tr>
      </thead>

      <tbody>
        {{#each customers}}
          <tr>
            <td>{{first_name}}</td>
            <td>{{last_name}}</td>
            <td>
              {{#if rentals}}
                {{rentals}}
              {{else}}
                Sense lloguers
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </main>

  {{> footer}}
</body>
</html>
